# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# SQLite by default. To move to Postgres later, change this to e.g.
# postgresql+psycopg2://user:password@host:5432/sa_tracker
DATABASE_URL=sqlite:///./sa_tracker.db

# Comma-separated list of origins allowed to call the API (the frontend dev
# server by default). Update for production deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max upload size in megabytes, enforced by the upload endpoint.
MAX_UPLOAD_MB=20

ENVIRONMENT=development
